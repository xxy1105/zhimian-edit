# Runtime
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional multi-user account array; when set, it replaces ADMIN_USERNAME/ADMIN_PASSWORD.
# AUTH_USERS_JSON=[{"id":"user-admin","username":"admin","passwordHash":"salt:scrypt-hex","name":"系统管理员","role":"超级管理员","projectKeys":[],"jobKeys":[]}]

# Shared production database
DATABASE_URL=postgresql://user:password@host:5432/zhimian
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# AI interview provider
INTERVIEW_PROVIDER_BASE_URL=https://provider.example.com
INTERVIEW_PROVIDER_API_KEY=
INTERVIEW_PROVIDER_ADMIN_PATH=/api/admin/interview-links
INTERVIEW_PROVIDER_TIMEOUT_MS=15000
INTERVIEW_PROVIDER_DEFAULT_DIFFICULTY=medium
INTERVIEW_PROVIDER_AUTO_NEXT=true
INTERVIEW_PROVIDER_NEXT_BREAK_SECONDS=30
INTERVIEW_PROVIDER_TTS_VOICE=zh_female_xiaohe_uranus_bigtts
INTERVIEW_PROVIDER_MAX_DURATION_SECONDS=1800
INTERVIEW_PROVIDER_TIMEOUT_SECONDS=60
INTERVIEW_PROVIDER_INTERVIEWER_NAME=AI·嘉欣

# Notification provider
NOTIFICATION_PROVIDER_BASE_URL=https://notification.example.com/api
NOTIFICATION_PROVIDER_API_KEY=
NOTIFICATION_PROVIDER_SEND_PATH=/notifications/send
NOTIFICATION_PROVIDER_HEALTH_PATH=/health

# Resume parser provider
RESUME_PARSER_BASE_URL=https://resume.example.com/api
RESUME_PARSER_API_KEY=
RESUME_PARSER_PATH=/resumes/parse

# Lark / Feishu Open Platform
LARK_APP_ID=
LARK_APP_SECRET=
LARK_OWNER_OPEN_ID=
LARK_CALENDAR_ID=
# Example: {"陈砚":"ou_xxx","梁序":"ou_yyy"}
LARK_HOST_MAP_JSON={}
